{
  "name": "envbridge",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Local browser environment state migration for Chrome and Edge.",
  "scripts": {
    "build:background": "node tools/build-background.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/build-background.mjs && node tests/browser.mjs",
    "test:popup": "node tests/popup-browser.mjs",
    "test:i18n": "node tests/i18n-browser.mjs",
    "test:cookies": "node tools/build-background.mjs && node tests/cookie-browser.mjs",
    "test:history": "node tools/build-background.mjs && node tests/history-browser.mjs",
    "vendor:tldts": "node tools/vendor-tldts.mjs",
    "check": "node tools/check.mjs",
    "package": "node tools/package.mjs",
    "demo": "node tools/demo-server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "tldts": "^7.4.16"
  }
}
